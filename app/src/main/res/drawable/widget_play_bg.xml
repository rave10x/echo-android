<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="24dp" android:centerColor="#66FF5C8A" android:endColor="#00FF5C8A" android:startColor="#B3FF5C8A" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_btn" />
            <stroke android:width="1.5dp" android:color="#CCFF5C8A" />
        </shape>
    </item>
</layer-list>
